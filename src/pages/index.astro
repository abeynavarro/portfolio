---
import '../styles/home.css'
import Card from '../components/card.astro'
import Navigation from '../components/navigation.astro'
import '../styles/card.css'
import ImgProgramaTuCuenta from '../assets/Programa tu cuenta.jpg'
import ImgMomentum from '../assets/Momentum.jpg'
import ImgJED from '../assets/JED.jpg'
import ImgMyandbank from '../assets/Myandbank.jpg'
import ImgABW from '../assets/ABW.jpg'
import ImgMyBusiness from '../assets/MyBusiness.jpg'
import ImgCuatrecasas from '../assets/Cuatrecasas.jpg'
import ImgIC from '../assets/IC.jpg'
import ImgPrestamos from '../assets/Préstamos.jpg'
import ImgAllianz from '../assets/Allianz.jpg'
import ImgHipotecas from '../assets/Hipotecas.jpg'
import ImgZurich from '../assets/Zurich.jpg'
import ImgFrances from '../assets/Francés.jpg'
import ImgInnovationEdge from '../assets/Innovation Edge.jpg'
import ImgTyC from '../assets/TyC.jpg'
import ImgNestle from '../assets/Nestlé.jpg'
import ImgAccionistas from '../assets/Accionistas.jpg'
import ImgING from '../assets/ING.jpg'
import ImgSeguros from '../assets/Seguros.jpg'
import ImgOpenTalent from '../assets/Open Talent.jpg'
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300..700&display=swap" rel="stylesheet">
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>ABN portfolio</title>
	</head>
	<body>
		<Navigation/>
		<div class="intro">
		<h1>Hola,</h1>
		<h4>soy Alfonso Bey, diseñador de Producto
Actualmente estoy creando productos y servicios digitales para Andbank.</h4
>
		</div>
		<div class="mainProjects">
<Card classCard="card cardgrande1" title="Programa tu cuenta" link="/projects/programatucuenta" image={ImgProgramaTuCuenta}/>
<Card classCard="card cardpequeña1" title="Momentum Project" link="/projects/momentum" image={ImgMomentum}/>
<Card classCard="card cardpequeña2" title="The jewellery editor" link="/projects/JED" image={ImgJED}/>
<Card classCard="card cardfull" title="Myandbank" link="/projects/myandbank" image={ImgMyandbank}/>
<Card classCard="card cardgrande2" title="Andbank Wealth" link="/projects/ABW" image={ImgABW}/>
<Card classCard="card cardpequeña3" title="BBVA My Business" link="/projects/BBVAMyB" image={ImgMyBusiness}/>
<Card classCard="card cardpequeña4" title="Cuatrecasas" link="/projects/Cuatrecasas" image={ImgCuatrecasas}/>
		</div>
		<div class="otherProjects">
<h2>Otros proyectos</h2>
<div class="otherProjectsCarousel">
<Card classCard="card cardcarousel" title="BBVA Innovation Center"  image={ImgIC}/>
<Card classCard="card cardcarousel" title="Préstamos BBVA"  image={ImgPrestamos}/>
<Card classCard="card cardcarousel" title="Portal mediador Allianz"  image={ImgAllianz}/>
<Card classCard="card cardcarousel" title="Hipotecas BBVA"  image={ImgHipotecas}/>
<Card classCard="card cardcarousel" title="App Zurich Santander"  image={ImgZurich}/>
<Card classCard="card cardcarousel" title="BBVA Francés"  image={ImgFrances}/>
<Card classCard="card cardcarousel" title="Innovation Edge"  image={ImgInnovationEdge}/>
<Card classCard="card cardcarousel" title="Web TyC BBVA"  image={ImgTyC}/>
<Card classCard="card cardcarousel" title="App recetas Nestlé"  image={ImgNestle}/>
<Card classCard="card cardcarousel" title="Web accionistas BBVA"  image={ImgAccionistas}/>
<Card classCard="card cardcarousel" title="ING com. interna"  image={ImgING}/>
<Card classCard="card cardcarousel" title="Seguros BBVA"  image={ImgSeguros}/>
<Card classCard="card cardcarousel" title="BBVA Open Talent"  image={ImgOpenTalent}/>

		</div>
	</body>
</html>
